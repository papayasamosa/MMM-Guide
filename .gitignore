# MCP dev tooling - local overrides and secrets never belong in the repo.
# .mcp.json itself IS committed deliberately (see docs/development/
# mcp_development_tooling.md) - it holds no secrets: GitHub uses OAuth,
# Context7 runs unauthenticated, Playwright needs no credentials.
.env.mcp
mcp.local.json
*.mcp.local.json
config/mcp/*.local.json
config/mcp/*.env
!config/mcp/*.env.example
test-artifacts/playwright-mcp/
logs/mcp/
playwright/.auth/
storage-state.json
