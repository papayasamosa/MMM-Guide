# Copy this file to config/mcp/mcp.env (or D:\Ancestry-MMM\secrets\) and fill
# in real values there. The filled-in copy must never be committed - see
# .gitignore (config/mcp/*.env is ignored; this .example file is not).
#
# Leave GITHUB_PERSONAL_ACCESS_TOKEN empty if your client/account uses the
# official remote GitHub MCP server over OAuth (no PAT needed). Only set it
# if you fall back to the local github-mcp-server binary.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional. Omit to use Context7 unauthenticated at a lower rate limit.
CONTEXT7_API_KEY=

# D-drive paths used by local MCP servers and helper scripts. Adjust the
# drive letter/root only if your machine's tooling root differs.
PLAYWRIGHT_BROWSERS_PATH=D:\Ancestry-MMM\cache\ms-playwright
PLAYWRIGHT_MCP_OUTPUT_DIR=D:\Ancestry-MMM\test-artifacts\playwright-mcp
npm_config_cache=D:\Ancestry-MMM\cache\npm

# Hugging Face MCP does not use a token here. Its connection is generated
# and authenticated through https://huggingface.co/settings/mcp in-browser.
